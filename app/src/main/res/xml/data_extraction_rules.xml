<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for API 31 and above. See
   https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- The session token is wrapped by a device-bound Keystore key, so a restored copy is useless. -->
        <exclude domain="sharedpref" path="fort_session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="fort_session.xml" />
    </device-transfer>
</data-extraction-rules>
